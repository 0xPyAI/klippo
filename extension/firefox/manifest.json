{
  "manifest_version": 2,
  "name": "Klippo Integration",
  "version": "1.7.6",
  "description": "Sends browser downloads and the videos you watch (YouTube too) to the Klippo download manager.",
  "web_accessible_resources": [
    "youtube_main.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "klippo@klippo.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "contextMenus",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "proxy"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_title": "Klippo: downloads and videos on this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
